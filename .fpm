-s dir ./target/debug/aeroshield ./target/debug/aeroshield-agent ./crates/gui/icons/app_icon.png package README.md LICENSE
--name aeroshield
--license MIT
--version 0.8.1
--description "A WiFi security auditing software mainly based on aircrack-ng tools suite"
--url "https://github.com/ameramarketing/aeroshield"
--maintainer "Amjad Khan <ameramarketing@gmail.com>"

--provides aeroshield
--conflicts aeroshield

--depends bash
--depends xterm
--depends iw
--depends macchanger
--depends aircrack-ng
--depends adwaita-icon-theme

target/debug/aeroshield=/usr/bin/aeroshield
target/debug/aeroshield-agent=/usr/bin/aeroshield-agent
crates/gui/icons/app_icon.png=/usr/share/pixmaps/aeroshield.png

package/.desktop=/usr/share/applications/com.ameramarketing.aeroshield.desktop
package/.policy=/usr/share/polkit-1/actions/org.freedesktop.policykit.aeroshield.policy

README.md=/usr/share/doc/aeroshield/README.md
LICENSE=/usr/share/doc/aeroshield/LICENSE